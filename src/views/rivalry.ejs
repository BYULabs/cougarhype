<%- include('partials/header') %>

<!-- Custom Component Styles -->
<style>
  .hype-bar { background: linear-gradient(90deg, #0062B8, #00A3E0 60%, #FFD700); }
  .ute-bar { background: linear-gradient(90deg, #7A0000, #CC0000 60%, #FFD700); }
  @keyframes pulse-glow { 0%,100% { box-shadow: 0 0 30px rgba(0,98,184,0.2); } 50% { box-shadow: 0 0 50px rgba(0,98,184,0.4); } }
  .hero-card { animation: pulse-glow 5s ease-in-out infinite; }
  .stat-card { transition: transform 0.3s ease, border-color 0.3s ease; }
  .stat-card:hover { transform: translateY(-4px); border-color: rgba(0,98,184,0.4); }
  .game-row { transition: background 0.2s ease, border-color 0.2s ease; }
  .game-row:hover { background: rgba(255,255,255,0.06); border-color: rgba(0,98,184,0.3); }
  .divider-gradient { background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent); }
</style>

<main class="bg-[#001528] text-gray-100 min-h-screen overflow-x-hidden">

  <!-- ====== RIVALRY HERO ====== -->
  <section class="relative overflow-hidden pt-12 sm:pt-16 pb-10">
    <div class="absolute inset-0">
      <div class="absolute top-0 left-1/4 w-96 h-96 bg-byuRoyal/15 rounded-full blur-3xl"></div>
      <div class="absolute top-10 right-1/4 w-80 h-80 bg-red-500/10 rounded-full blur-3xl"></div>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8">
        <span class="inline-flex items-center gap-2 text-amber-400 font-bold text-xs sm:text-sm tracking-[0.3em] uppercase">
          <i class="fas fa-fire"></i> Series History Breakdown
        </span>
      </div>

      <!-- Hero Card -->
      <div class="hero-card max-w-5xl mx-auto bg-gradient-to-br from-[#00375E]/80 to-byuNavy/50 border border-white/10 rounded-3xl p-6 sm:p-10 shadow-2xl backdrop-blur-sm relative overflow-hidden">
        <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: repeating-linear-gradient(45deg, transparent, transparent 35px, rgba(255,255,255,0.15) 35px, rgba(255,255,255,0.15) 70px);"></div>

        <h1 class="relative text-center text-4xl sm:text-6xl font-black text-white tracking-tighter mb-2 uppercase">
          BYU <span class="text-amber-400">vs</span> <%= opponent %>
        </h1>
        <p class="relative text-center text-gray-400 text-sm sm:text-base mb-8">A Battle for Conference Supremacy</p>

        <!-- Teams & Record Bar -->
        <div class="relative flex items-center justify-around gap-4 sm:gap-8 flex-wrap">
          <!-- BYU -->
          <div class="text-center flex-1 min-w-[130px]">
            <div class="w-24 h-24 sm:w-32 sm:h-32 mx-auto mb-3 rounded-full bg-gradient-to-br from-byuRoyal to-byuNavy flex items-center justify-center shadow-2xl border-4 border-white/10 overflow-hidden p-3">
              <img src="<%= byuLogo %>" alt="BYU" class="w-full h-full object-contain">
            </div>
            <div class="text-xl sm:text-2xl font-black text-white">BYU Cougars</div>
            <div class="text-xs text-gray-400 uppercase tracking-wide font-semibold mt-1">Provo, UT</div>
          </div>

          <!-- VS / Record -->
          <div class="flex flex-col items-center gap-3">
            <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-white/5 border border-white/10 flex items-center justify-center">
              <i class="fas fa-football text-2xl sm:text-3xl text-amber-400"></i>
            </div>
            <div class="text-center">
              <div class="flex items-center gap-2 sm:gap-3">
                <span class="text-2xl sm:text-3xl font-black text-green-400"><%= stats.byuWins %></span>
                <span class="text-gray-500 text-lg">–</span>
                <span class="text-2xl sm:text-3xl font-black text-red-400"><%= stats.opponentWins %></span>
                <% if (stats.ties > 0) { %>
                  <span class="text-gray-500 text-lg">–</span>
                  <span class="text-2xl sm:text-3xl font-black text-gray-500"><%= stats.ties %></span>
                <% } %>
              </div>
              <div class="flex items-center gap-2 sm:gap-3 text-[10px] sm:text-xs text-gray-400 uppercase tracking-wide font-semibold mt-1">
                <span class="text-green-400">BYU W</span>
                <span class="text-red-400"><%= opponent.substring(0, 5).toUpperCase() %> W</span>
                <% if (stats.ties > 0) { %><span class="text-gray-500">Tie</span><% } %>
              </div>
            </div>
          </div>

          <!-- Opponent -->
          <div class="text-center flex-1 min-w-[130px]">
            <div class="w-24 h-24 sm:w-32 sm:h-32 mx-auto mb-3 rounded-full bg-white/5 flex items-center justify-center shadow-2xl border-4 border-white/10 overflow-hidden p-3">
              <img src="<%= opponentLogo %>" alt="<%= opponent %>" class="w-full h-full object-contain">
            </div>
            <div class="text-xl sm:text-2xl font-black text-white"><%= opponent %></div>
            <div class="text-xs text-gray-400 uppercase tracking-wide font-semibold mt-1">Opponent</div>
          </div>
        </div>

        <!-- Quick Facts -->
        <div class="relative mt-8 pt-6 border-t border-white/10 grid grid-cols-2 sm:grid-cols-3 gap-4 text-center">
          <div>
            <div class="text-2xl font-black text-white"><%= stats.totalGames %></div>
            <div class="text-[10px] text-gray-400 uppercase tracking-wide font-semibold mt-1">Total Games Played</div>
          </div>
          <div>
            <div class="text-2xl font-black text-green-400"><%= stats.byuWins %></div>
            <div class="text-[10px] text-gray-400 uppercase tracking-wide font-semibold mt-1">BYU Victory Count</div>
          </div>
          <div class="col-span-2 sm:col-span-1">
            <div class="text-2xl font-black text-amber-400"><%= stats.byuAvgPts %></div>
            <div class="text-[10px] text-gray-400 uppercase tracking-wide font-semibold mt-1">BYU Avg Points</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ====== ALL-TIME SERIES BREAKDOWN ====== -->
  <section class="py-10 sm:py-14 bg-gradient-to-b from-transparent to-byuNavy/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8">
        <h2 class="text-2xl sm:text-3xl font-black text-white mb-2">All-Time Series Breakdown</h2>
        <p class="text-gray-400 text-sm">Head-to-head metrics powered by CFBD.</p>
      </div>

      <div class="grid lg:grid-cols-2 gap-6">
        <!-- Win Share Conic Pie -->
        <div class="bg-gradient-to-br from-[#00375E]/70 to-byuNavy/40 border border-white/10 rounded-2xl p-6 text-center flex flex-col justify-center">
          <h3 class="font-bold text-white text-sm mb-5 uppercase tracking-wide">Win Share</h3>
          <div class="relative w-40 h-40 mx-auto mb-4">
            <div class="absolute inset-0 rounded-full" style="background: conic-gradient(#0062B8 0% <%= stats.byuWinPct %>%, #CC0000 <%= stats.byuWinPct %>% <%= stats.byuWinPct + stats.oppWinPct %>%, #4B5563 <%= stats.byuWinPct + stats.oppWinPct %>% 100%);"></div>
            <div class="absolute inset-4 rounded-full bg-[#001528] flex flex-col items-center justify-center">
              <span class="text-3xl font-black text-white"><%= stats.totalGames %></span>
              <span class="text-[10px] text-gray-400 uppercase tracking-wide">Games</span>
            </div>
          </div>
          <div class="flex justify-center gap-4 text-xs">
            <div class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-byuRoyal"></span><span class="text-gray-300">BYU <%= stats.byuWinPct %>%</span></div>
            <div class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-red-600"></span><span class="text-gray-300"><%= opponent %> <%= stats.oppWinPct %>%</span></div>
            <% if (stats.tiePct > 0) { %>
              <div class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-gray-600"></span><span class="text-gray-300">Tie <%= stats.tiePct %>%</span></div>
            <% } %>
          </div>
        </div>

        <!-- Scoring Metrics -->
        <div class="bg-gradient-to-br from-[#00375E]/70 to-byuNavy/40 border border-white/10 rounded-2xl p-6">
          <h3 class="font-bold text-white text-sm mb-5 uppercase tracking-wide text-center">Scoring Totals</h3>
          <div class="space-y-4">
            <div class="text-center">
              <div class="text-3xl font-black text-byuRoyal"><%= stats.byuTotalPts %></div>
              <div class="text-[10px] text-gray-400 uppercase tracking-wide font-semibold mt-1">BYU Points Scored</div>
            </div>
            <div class="divider-gradient h-px"></div>
            <div class="text-center">
              <div class="text-3xl font-black text-red-500"><%= stats.oppTotalPts %></div>
              <div class="text-[10px] text-gray-400 uppercase tracking-wide font-semibold mt-1"><%= opponent %> Points Scored</div>
            </div>
            <div class="divider-gradient h-px"></div>
            <div class="grid grid-cols-2 gap-2 text-center pt-2">
              <div>
                <div class="text-xl font-black text-amber-400"><%= stats.byuAvgPts %></div>
                <div class="text-[9px] text-gray-400 uppercase">Avg. BYU Pts</div>
              </div>
              <div>
                <div class="text-xl font-black text-amber-400"><%= stats.oppAvgPts %></div>
                <div class="text-[9px] text-gray-400 uppercase">Avg. <%= opponent %> Pts</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ====== RECENT MEETINGS ====== -->
  <section class="py-10 sm:py-14">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between mb-6 flex-wrap gap-2">
        <div>
          <h2 class="text-2xl sm:text-3xl font-black text-white mb-1">Recent Meetings</h2>
          <p class="text-gray-400 text-sm">Last <%= recentGames.length %> games in the series.</p>
        </div>
        <div class="flex items-center gap-2 text-xs">
          <div class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-green-500"></span><span class="text-gray-400">BYU Win</span></div>
          <div class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-red-500"></span><span class="text-gray-400"><%= opponent %> Win</span></div>
        </div>
      </div>

      <div class="bg-gradient-to-br from-[#00375E]/50 to-byuNavy/20 border border-white/10 rounded-2xl overflow-hidden">
        <div class="hidden sm:grid grid-cols-12 gap-2 px-5 py-3 bg-white/5 border-b border-white/10 text-[10px] uppercase tracking-wide font-semibold text-gray-400">
          <div class="col-span-3">Season</div>
          <div class="col-span-3">Location</div>
          <div class="col-span-4 text-center">Score</div>
          <div class="col-span-2 text-right">Winner</div>
        </div>

        <% if (recentGames && recentGames.length > 0) { %>
          <% recentGames.forEach(g => { %>
            <% const byuWon = g.winner === 'byu'; %>
            <div class="game-row grid grid-cols-12 gap-2 px-4 sm:px-5 py-3 border-b border-white/5 items-center <%= byuWon ? 'border-l-2 border-l-green-500' : 'border-l-2 border-l-red-500' %>">
              <div class="col-span-4 sm:col-span-3 text-xs text-gray-300 font-medium"><%= g.date %></div>
              <div class="col-span-4 sm:col-span-3 text-xs text-gray-400 hidden sm:block truncate"><%= g.location %></div>
              <div class="col-span-5 sm:col-span-4 text-center text-xs">
                <span class="<%= byuWon ? 'text-green-400 font-black' : 'text-gray-400' %>">BYU <%= g.byuScore %></span>
                <span class="text-gray-600 mx-1">—</span>
                <span class="<%= !byuWon ? 'text-red-400 font-black' : 'text-gray-400' %>"><%= g.oppScore %> <%= opponent.substring(0, 4).toUpperCase() %></span>
              </div>
              <div class="col-span-3 sm:col-span-2 text-right">
                <% if (byuWon) { %>
                  <span class="inline-flex items-center gap-1 text-green-400 font-bold text-xs"><i class="fas fa-check-circle text-[10px]"></i> BYU</span>
                <% } else { %>
                  <span class="inline-flex items-center gap-1 text-red-400 font-bold text-xs"><i class="fas fa-check-circle text-[10px]"></i> <%= opponent.substring(0, 5) %></span>
                <% } %>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="p-5 text-center text-gray-400 text-sm">No recent matchup history found.</div>
        <% } %>
      </div>
    </div>
  </section>

</main>

<%- include('partials/footer') %>