<%- include('partials/header') %>

<main class="max-w-7xl mx-auto px-4 py-12 text-white">
  <div class="text-center mb-8">
    <h1 class="text-3xl font-black">BYU vs <%= opponent %></h1>
    <p class="text-gray-400">Head-to-Head History & Metrics</p>
  </div>

  <!-- Overall Matchup Record -->
  <div class="bg-gradient-to-br from-[#00375E]/70 to-byuNavy/40 border border-white/10 rounded-2xl p-6 mb-8 text-center">
    <div class="flex items-center justify-around gap-4 mb-6">
      <div>
        <img src="<%= byuLogo %>" alt="BYU" class="w-16 h-16 mx-auto mb-2 object-contain">
        <h2 class="text-xl font-bold">BYU</h2>
        <p class="text-2xl font-black text-green-400"><%= matchup.team1Wins || 0 %> Wins</p>
      </div>
      <div class="text-2xl font-black text-gray-500">VS</div>
      <div>
        <img src="<%= opponentLogo %>" alt="<%= opponent %>" class="w-16 h-16 mx-auto mb-2 object-contain">
        <h2 class="text-xl font-bold"><%= opponent %></h2>
        <p class="text-2xl font-black text-red-400"><%= matchup.team2Wins || 0 %> Wins</p>
      </div>
    </div>
  </div>

  <!-- Historical Game Scores -->
  <div class="bg-gradient-to-br from-[#00375E]/70 to-byuNavy/40 border border-white/10 rounded-2xl p-6">
    <h3 class="text-lg font-bold mb-4">Historical Games</h3>
    <div class="space-y-3">
      <% if (matchup.games && matchup.games.length > 0) { %>
        <% matchup.games.forEach(game => { %>
          <div class="flex justify-between items-center bg-white/5 border border-white/10 p-3 rounded-xl text-sm">
            <span><%= game.season %> - <%= game.venue || 'TBD' %></span>
            <span class="font-bold">
              BYU <%= game.homeTeam === 'BYU' ? game.homeScore : game.awayScore %> 
              - 
              <%= game.homeTeam === 'BYU' ? game.awayScore : game.homeScore %> <%= opponent %>
            </span>
          </div>
        <% }) %>
      <% } else { %>
        <p class="text-gray-400 text-sm">No historical matchups found.</p>
      <% } %>
    </div>
  </div>
</main>

<%- include('partials/footer') %>