<%- include('partials/header') %>

<main class="home-container">
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="countdown-module">
      <div class="hero-left">
        <span class="badge live">
          <span class="live-dot"></span> 
          <%= nextGame ? 'Game Week ' + nextGame.week : 'Offseason' %>
        </span>
        <h2>Next Kickoff Tracker</h2>
        <div class="matchup-strip">
          <!-- BYU Team -->
          <div class="team">
            <img src="<%= (nextGame && nextGame.byuLogo) ? nextGame.byuLogo : 'https://ssl.gstatic.com/onebox/media/sports/logos/optimized/hxz7taoji58jiIwg5XOu9A_120x120.png' %>" alt="BYU Logo">
            <h3>BYU</h3>
          </div>
          
          <span class="vs-divider">VS</span>
          
          <!-- Opponent Team -->
          <div class="team">
            <% if (nextGame && nextGame.opponentLogo) { %>
              <img src="<%= nextGame.opponentLogo %>" alt="<%= nextGame.opponent %> Logo">
            <% } else { %>
              <!-- Fallback badge if no logo image is returned -->
              <div class="opp-badge-hero">
                <%= nextGame ? nextGame.opponent.substring(0, 2).toUpperCase() : 'VS' %>
              </div>
            <% } %>
            <h3><%= nextGame ? nextGame.opponent : 'Opponent' %></h3>
          </div>
        </div>

        <p class="stadium-text">
          🏟️ <%= nextGame ? nextGame.venue : 'TBD Venue' %> 
          <%= nextGame && nextGame.isHome ? '| Provo, UT' : '' %>
        </p>
      </div>

      <div class="hero-right">
        <!-- Pass the next game start date to JavaScript data attribute for the clock -->
        <div class="countdown-clock" id="countdown-clock" data-kickoff="<%= nextGame ? nextGame.startDate : '' %>">
          <div><span class="num" id="cd-days">--</span><span class="lbl">Days</span></div>
          <div><span class="num" id="cd-hours">--</span><span class="lbl">Hours</span></div>
          <div><span class="num" id="cd-mins">--</span><span class="lbl">Mins</span></div>
          <div><span class="num" id="cd-secs">--</span><span class="lbl">Secs</span></div>
        </div>
        
        <div class="broadcast-tag">
          📺 <strong>ESPN / BYUtv</strong> · 
          <% if (nextGame && nextGame.startDate) { %>
            <%= new Date(nextGame.startDate).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' }) %>
          <% } else { %>
            Date TBD
          <% } %>
        </div>
      </div>
    </div>
  </section>

  <!-- Bento Grid Section -->
  <section class="bento-grid">
    <div class="bento-wrapper">
      
      <!-- Dynamic Schedule / Standings Table -->
      <div class="dashboard-panel standings-widget">
        <h3><%= year %> BYU Schedule</h3>
        <table class="standings-table">
          <thead>
            <tr>
              <th>Wk</th>
              <th>Opponent</th>
              <th>Site</th>
              <th>Venue</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% if (schedule && schedule.length > 0) { %>
              <% schedule.forEach(game => { %>
                <tr>
                  <td><strong>Wk <%= game.week %></strong></td>
                  <td style="display: flex; align-items: center; gap: 8px;">
                    <img src="<%= game.opponentLogo %>" width="20" height="20" alt="" style="object-fit: contain;">
                    <%= game.opponent %>
                  </td>
                  <td><%= game.isHome ? 'Home' : 'Away' %></td>
                  <td><%= game.venue %></td>
                  <td>
                    <% if (game.completed) { %>
                      <span style="color: #4CAF50; font-weight: bold;">Final</span>
                    <% } else { %>
                      <span style="color: #888;">Upcoming</span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="5">Unable to load schedule data.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <!-- Result Highlight Widget (Most recent completed game) -->
      <% const lastGame = schedule.filter(g => g.completed).pop(); %>
      <div class="dashboard-panel results-widget">
        <h3>Latest Game Breakdown</h3>
        <div class="result-hero-card win">
          <div class="bowl-tag">
            <%= lastGame ? 'Week ' + lastGame.week : 'Season Preview' %>
          </div>
          <div class="score-display">
            <span class="team-name">BYU</span>
            <span class="final-score">
              <%= lastGame ? 'Final' : '0 - 0' %>
            </span>
            <span class="team-name">
              <%= lastGame ? lastGame.opponent : 'Opponent' %>
            </span>
          </div>
          <p class="game-meta">
            <%= lastGame ? lastGame.venue : 'No completed games played yet.' %>
          </p>
        </div>
      </div>

    </div>
  </section>

  <!-- Spotlight Section -->
  <section class="spotlight-section">
    <h2><%= year %> Key Catalysts</h2>
    <div class="spotlight-cards-wrapper">
      <!-- Dynamic player cards can be dynamically populated here if passed from controller -->
    </div>
  </section>

  <!-- Community Section -->
  <section class="community-zone">
    <div class="poll-section">
      <h3 class="poll-question">🏆 What's BYU's ceiling in <%= year %>?</h3>
      <div class="poll-options" id="poll-options">
        <div class="poll-option" data-votes="184">
          <div class="poll-fill" style="width: 46.7%;"></div>
          <div class="poll-content">
            <span class="poll-text">Big 12 Champions &amp; College Football Playoff</span>
            <span class="poll-percent">46.7%</span>
          </div>
        </div>
        <div class="poll-option" data-votes="132">
          <div class="poll-fill" style="width: 33.5%;"></div>
          <div class="poll-content">
            <span class="poll-text">10+ win season and a New Year's Six bowl</span>
            <span class="poll-percent">33.5%</span>
          </div>
        </div>
      </div>
      <p class="poll-thanks" id="poll-thanks">✅ Vote counted! Go Cougs — rise and shout!</p>
    </div>
  </section>
</main>

<%- include('partials/footer') %>